generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model Attendance {
  id          String    @id @default(nanoid())
  peopleId    String
  entryAt     DateTime  @default(now())
  observation String?
  exitAt      DateTime?
  people      People    @relation(fields: [peopleId], references: [id])
}

model WeeklyObservation {
  id          String   @id @default(cuid())
  peopleId    String
  weekStart   DateTime // sempre uma segunda-feira
  observation String

  people People @relation(fields: [peopleId], references: [id])
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  pass      String
  urlImage  String?
  createdAt DateTime  @default(now())
  isAdm     IsUserAdm @default(No)
}

model People {
  id        String       @id @default(cuid())
  name      String
  email     String?      @unique
  status    peopleStatus
  course    String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  loans     Loan[]

  attendances Attendance[]

  weeklyObservations WeeklyObservation[]
}

model Book {
  id              String    @id @default(uuid())
  title           String
  author          String
  barcode         String?   @unique
  categoryId      String?
  totalCopies     Int       @default(0)
  availableCopies Int       @default(0)
  publisher       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  category        Category? @relation(fields: [categoryId], references: [id])
  loans           Loan[]
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  books     Book[]
}

model Loan {
  id         String     @id @default(cuid())
  peopleId   String
  bookId     String?
  loanDate   DateTime   @default(now())
  dueDate    DateTime
  returnDate DateTime?
  status     LoanStatus @default(ACTIVE)
  book       Book?      @relation(fields: [bookId], references: [id])
  people     People     @relation(fields: [peopleId], references: [id])
}

enum LoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
  LOST
}

enum IsUserAdm {
  Yes
  No
}

enum peopleStatus {
  DICENTE
  DOCENTE
}
