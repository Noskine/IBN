generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  pass      String
  urlImage  String?
  createdAt DateTime  @default(now())
  isAdm     IsUserAdm @default(No)
}

